# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Render injects PORT automatically; only set this for local runs.
PORT=3000
NODE_ENV=production

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
# JWT_SECRET should be set via your environment / secret management service
# Generate with: openssl rand -hex 32

# Comma-separated list of allowed browser origins.
# Set this to your Vercel URL, e.g. https://cee-nepal-portal.vercel.app
# Use * only for local development.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the local SQLite file (./data/cee.db).
# Set it to your Supabase connection string to use PostgreSQL:
#   Supabase -> Settings -> Database -> Connection string -> URI
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Optional: override the local SQLite file location.
# SQLITE_PATH=./data/cee.db
