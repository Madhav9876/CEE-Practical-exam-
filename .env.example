# Server Configuration
PORT=3000
NODE_ENV=production

# Security
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# Database
# SQLite database is stored in ./data/cee.db
# For production, consider PostgreSQL or MySQL for better scalability
DATABASE_PATH=./data/cee.db

# Application
APP_NAME=CEE Nepal Exam Portal
APP_URL=https://your-domain.com

# CORS (comma-separated origins for production)
CORS_ORIGIN=*